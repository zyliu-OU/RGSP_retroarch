--- a/frontend/drivers/platform_unix.c
+++ b/frontend/drivers/platform_unix.c
@@ -2564,6 +2564,19 @@ static bool frontend_unix_set_fork(enum frontend_fork fork_mode)
 
 static void frontend_unix_exec(const char *path, bool should_load_content)
 {
+#ifdef HAVE_RGSP
+   /* Restart must keep the writable shared config selected by the supervisor. */
+   const char *config_path = path_get(RARCH_PATH_CONFIG);
+   char *newargv[] = { (char*)path, NULL, NULL, NULL };
+
+   if (!string_is_empty(config_path))
+   {
+      newargv[1] = (char*)"--config";
+      newargv[2] = (char*)config_path;
+   }
+   sync();
+   execv(path, newargv);
+#else
    char *newargv[]    = { NULL, NULL };
    size_t _len        = strlen(path);
 
@@ -2572,6 +2585,7 @@ static void frontend_unix_exec(const char *path, bool should_load_content)
    strlcpy(newargv[0], path, _len);
 
    execv(path, newargv);
+#endif
 }
 
