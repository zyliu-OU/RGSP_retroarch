#!/bin/sh
# BusyBox-init session with an explicit main-menu Shutdown action.
set -u
RA=/mnt/vendor/deep/retro/retroarch
CFG=/.config/retroarch/retroarch.cfg
LOG=/var/log/rgsp-retroarch.log
PID=/run/rgsp-retroarch-supervisor.pid

start_session() {
    mkdir -p /mnt/vendor /mnt/mmc /mnt/shared /var/log /run /.config/retroarch
    mountpoint -q /mnt/vendor || mount -t ext4 -o ro,noload /dev/mmcblk0p6 /mnt/vendor || {
        echo 'RGSP: cannot mount appfs p6' > /dev/console; return 1;
    }
    mountpoint -q /mnt/mmc || mount -t vfat -o rw,utf8 /dev/mmcblk0p1 /mnt/mmc || \
        echo 'RGSP: ROM partition unavailable; continuing' > /dev/console
    mountpoint -q /mnt/shared || \
        mount -t vfat -o rw,utf8 /dev/mmcblk0p7 /mnt/shared || \
        echo 'RGSP: shared partition unavailable; use /mnt/mmc' > /dev/console
    # Load Content starts at /mnt, with both PC-readable card volumes.
    sed -i 's|^rgui_browser_directory = .*|rgui_browser_directory = "/mnt"|' "$CFG"
    if [ ! -e /dev/mali0 ] && [ -f /lib/modules/mali_kbase.ko ]; then
        insmod /lib/modules/mali_kbase.ko >> "$LOG" 2>&1 || true
    fi
    [ -x "$RA" ] && [ -f "$CFG" ] || {
        echo 'RGSP: RetroArch or configuration missing' > /dev/console; return 1;
    }
    (
        export HOME=/
        export XDG_CONFIG_HOME=/.config
        export LD_LIBRARY_PATH=/usr/lib32:/usr/lib/arm-linux-gnueabihf:/mnt/vendor/lib
        export SDL_VIDEODRIVER=mali
        export SDL_AUDIODRIVER=alsa
        export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
        cd /mnt/vendor/deep/retro || exit 1
        while :; do
            /usr/local/sbin/rgsp-speaker off >> "$LOG" 2>&1 || true
            "$RA" --config "$CFG" >> "$LOG" 2>&1 &
            ra_pid=$!
            (
                sleep 2
                if kill -0 "$ra_pid" 2>/dev/null; then
                    /usr/local/sbin/rgsp-speaker on >> "$LOG" 2>&1 || true
                fi
            ) &
            wait "$ra_pid"
            rc=$?
            /usr/local/sbin/rgsp-speaker off >> "$LOG" 2>&1 || true
            if [ "$rc" -eq 0 ]; then
                echo 'Main-menu Shutdown selected; powering off' >> "$LOG"
                sleep 1
                sync
                /sbin/poweroff >> "$LOG" 2>&1
                echo 'Poweroff request failed; restarting RetroArch' >> "$LOG"
            else
                echo "RetroArch exited unexpectedly ($rc); restarting" >> "$LOG"
            fi
            sleep 2
        done
    ) &
    echo "$!" > "$PID"
}

case "${1:-start}" in
    start) start_session ;;
    stop)
        /usr/local/sbin/rgsp-speaker off >> "$LOG" 2>&1 || true
        if [ -r "$PID" ]; then
            kill "$(cat "$PID")" 2>/dev/null || true
            rm -f "$PID"
        fi
        killall retroarch 2>/dev/null || true
        ;;
    restart) "$0" stop; "$0" start ;;
    *) echo "Usage: $0 start|stop|restart" >&2; exit 2 ;;
esac
